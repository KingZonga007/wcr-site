---
import '../styles/global.css';
import { SITE, href, PREVIEW, inSeason } from '../lib/site.js';
import EmailForm from '../components/EmailForm.astro';
import oswald600 from '@fontsource/oswald/files/oswald-latin-600-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter600 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import oswald500 from '@fontsource/oswald/files/oswald-latin-500-normal.woff2?url';

const { title, description = SITE.mission, image = '/img/band-best-1600.webp', schema = [], current = '' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  '@id': `${SITE.url}/#artist`,
  name: SITE.name,
  description: SITE.mission,
  url: SITE.url,
  genre: ['Worship', 'Christian'],
  member: [
    { '@type': 'Person', name: 'Jonathan Baird' },
    { '@type': 'Person', name: 'Ryan Baird' },
  ],
  sameAs: [SITE.social.spotify, SITE.social.applePodcasts, SITE.social.youtube],
  legalName: SITE.legalName,
  email: SITE.email,
  ...(SITE.ein ? { taxID: SITE.ein } : {}),
  ...(SITE.addressParts ? { address: { '@type': 'PostalAddress', streetAddress: SITE.addressParts.street, addressLocality: SITE.addressParts.city, addressRegion: SITE.addressParts.region, postalCode: SITE.addressParts.postal, addressCountry: SITE.addressParts.country } } : {}),
};
const christmas = inSeason('christmas');
const nav = [
  ...(christmas ? [{ label: 'Christmas', path: '/christmas', key: 'christmas', season: SITE.season.christmas.to }] : []),
  { label: 'Songs & charts', path: '/songs', key: 'songs' },
  { label: 'Worship Is Warfare', path: '/worship-is-warfare', key: 'wiw' },
  { label: 'Our ministry', path: '/ministry', key: 'ministry' },
  { label: 'Invite us', path: '/invite', key: 'invite' },
  { label: 'About', path: '/about', key: 'about' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={oswald600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={oswald500} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, SITE.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0c16" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify([orgSchema, ...schema])} />
    {!PREVIEW && SITE.gaId && <script is:inline define:vars={{ gaSrc: `https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}` }}>
      // Load analytics after the page has finished loading so it never slows the first paint.
      window.addEventListener('load', function () {
        setTimeout(function () { var s = document.createElement('script'); s.async = true; s.src = gaSrc; document.head.appendChild(s); }, 1200);
      });
    </script>}
    <script is:inline define:vars={{ gaId: PREVIEW ? null : SITE.gaId }}>
      // Google Analytics 4. Every site event goes through wcrTrack. Sign-ups and booking requests
      // also send GA4's recommended generate_lead event, which is marked as a key event (conversion).
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      if (gaId) { window.gtag('js', new Date()); window.gtag('config', gaId); }
      var LEADS = ['sign_up', 'chart_signup', 'reminder_signup', 'booking_submit'];
      window.wcrTrack = function (event, params) {
        params = params || {};
        window.gtag('event', event, params);
        if (LEADS.indexOf(event) > -1) window.gtag('event', 'generate_lead', { lead_source: event, form_source: params.source || params.type || '' });
      };
      // Hide seasonal elements once their window has passed, even before the next rebuild.
      document.addEventListener('DOMContentLoaded', function () {
        var today = new Date().toISOString().slice(0, 10);
        document.querySelectorAll('[data-season-end]').forEach(function (el) { if (today > el.getAttribute('data-season-end')) el.hidden = true; });
      });
      window.wcrStore = {
        get: function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
        set: function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} },
      };
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href('/')}>West Coast Revival</a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
        <nav id="nav" class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={href(n.path)} aria-current={current === n.key ? 'page' : undefined} class={n.season ? 'nav-xmas' : undefined} data-season-end={n.season}>{n.label}</a>
          ))}
          <a class="btn primary" href={href('/give')}>Give</a>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    {!['give', 'thanks'].includes(current) && (
      <section class="involve" aria-label="Get involved">
        <div class="wrap">
          <p class="eyebrow">Get involved</p>
          <h2>Join what God is doing through song</h2>
          <div class="grid">
            <a class="card" href={href('/songs')}><strong>Get free charts</strong><span>Chord charts in two keys for your worship team</span></a>
            <a class="card" href={href('/worship-is-warfare')}><strong>Worship with us live</strong><span>Tuesdays and Thursdays, 6am MST</span></a>
            <a class="card" href={href('/invite')}><strong>Invite us</strong><span>Worship nights, services and workshops</span></a>
            <a class="card" href={href('/give')}><strong>Give</strong><span>Keep the songs and charts free for every church</span></a>
          </div>
        </div>
      </section>
    )}
    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <p class="eyebrow">Join the list</p>
            <h3>New songs and free charts, first.</h3>
            <EmailForm source="footer" cta="Join" compact />
          </div>
          <div>
            <p class="eyebrow">Explore</p>
            <ul>
              <li><a href={href('/songs')}>Songs and free charts</a></li>
              <li><a href={href('/worship-is-warfare')}>Worship Is Warfare</a></li>
              <li><a href={href('/invite')}>Invite us</a></li>
              <li><a href={href('/about')}>About</a></li>
              <li><a href={href('/press')}>Press kit</a></li>
              <li><a href={href('/ministry')}>Our ministry</a></li>
              <li><a href={href('/updates')}>Updates</a></li>
              <li><a href={href('/give')}>Give</a></li>
              <li><a href={href('/contact')}>Contact</a></li>
            </ul>
          </div>
          <div>
            <p class="eyebrow">Listen</p>
            <ul>
              <li><a href={SITE.social.spotify} data-out="spotify">Spotify</a></li>
              <li><a href={SITE.social.applePodcasts} data-out="apple_podcasts">Apple Podcasts</a></li>
              <li><a href={SITE.social.youtube} data-out="youtube">YouTube</a></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <p>{SITE.legalName} is a 501(c)(3) nonprofit ministry.{SITE.ein && ` EIN ${SITE.ein}.`} Gifts are tax-deductible as allowed by law.{SITE.address && ` ${SITE.address}.`} Contact: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <p>&copy; {new Date().getFullYear()} West Coast Revival · <a href={href('/privacy')}>Privacy</a> · <a href={href('/terms')}>Terms</a></p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var t = document.querySelector('.menu-toggle'), n = document.getElementById('nav');
        if (t && n) t.addEventListener('click', function () {
          var open = n.classList.toggle('open'); t.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[data-out]');
          if (a) window.wcrTrack('outbound_listen', { platform: a.getAttribute('data-out'), page: location.pathname });
        });
        // Remember UTM tags for attribution on signups.
        try {
          var p = new URLSearchParams(location.search);
          ['utm_source', 'utm_medium', 'utm_campaign'].forEach(function (k) { if (p.get(k)) sessionStorage.setItem(k, p.get(k)); });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
