---
import Base from '../layouts/Base.astro';
import { SITE, href } from '../lib/site.js';
---
<Base title="Terms of Use" description="Terms for using westcoastrevival.org and West Coast Revival's free chord charts.">
  <section class="section"><div class="wrap prose">
    <h1>Terms of use</h1>
    <p class="muted">Effective November 9, 2026</p>
    <p>By using westcoastrevival.org you agree to these terms.</p>
    <h2>Free chord charts</h2>
    <p>Our chord charts are free for use in church services, small groups and personal worship. Please report congregational use of our songs through your CCLI license where applicable. Charts may not be sold or redistributed for profit.</p>
    <h2>Music and recordings</h2>
    <p>Songs, recordings, photos and text on this site remain the property of their copyright holders. Songs first released with Sovereign Grace Music are credited on their song pages.</p>
    <h2>Giving</h2>
    <p>Gifts are made through the National Christian Foundation (NCF) and are tax-deductible as allowed by law. See our <a href={href('/give')}>Give page</a> for details.</p>
    <h2>Other websites</h2>
    <p>We link to services such as Spotify, Apple Music, YouTube and NCF. Those sites have their own terms and privacy policies.</p>
    <h2>Changes and contact</h2>
    <p>We may update these terms from time to time. Questions: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. See also our <a href={href('/privacy')}>privacy policy</a>.</p>
  </div></section>
</Base>
