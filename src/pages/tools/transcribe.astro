---
// Internal tool (noindex, not linked, not in sitemap): transcribes our own podcast audio
// in the browser with Whisper, and tells Ryan's voice from Jonathan's with speaker
// embeddings. Audio comes from /api/podcast (our RSS enclosures only).
import Base from '../../layouts/Base.astro';
---
<Base title="Transcribe" noindex>
  <section class="section"><div class="wrap">
    <h1>Transcribe</h1>
    <p class="muted">Internal tool. Status: <span id="st">idle</span></p>
    <pre id="out" style="white-space:pre-wrap"></pre>
  </div></section>
  <script is:inline type="module">
    import { pipeline, AutoProcessor, AutoModel, env } from 'https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.7.1';
    env.allowLocalModels = false;
    const st = (t) => (document.getElementById('st').textContent = t);
    const secs = (d) => d.split(':').reduce((a, x) => a * 60 + Number(x), 0);
    let LIST = null;
    async function list() { if (!LIST) LIST = await (await fetch('/api/podcast?list=1')).json(); return LIST; }
    // Decode [t0, t1) seconds of item i to 16 kHz mono Float32Array (assumes constant bitrate).
    async function audio(i, t0, t1) {
      const it = (await list())[i];
      const total = it.length, dur = secs(it.duration);
      const bps = total / dur;
      const a = Math.floor(t0 * bps), b = Math.floor(t1 * bps);
      const parts = [];
      for (let s = a; s < b; s += 4_000_000) {
        const r = await fetch(`/api/podcast?i=${i}&start=${s}&end=${Math.min(b, s + 4_000_000)}`);
        parts.push(new Uint8Array(await r.arrayBuffer()));
      }
      const buf = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
      let o = 0; for (const p of parts) { buf.set(p, o); o += p.length; }
      const ac = new AudioContext();
      const dec = await ac.decodeAudioData(buf.buffer);
      const off = new OfflineAudioContext(1, Math.ceil(dec.duration * 16000), 16000);
      const src = off.createBufferSource(); src.buffer = dec; src.connect(off.destination); src.start();
      return (await off.startRendering()).getChannelData(0);
    }
    let asr = null, asrKey = '';
    const DEF = { model: 'onnx-community/whisper-base.en', device: 'wasm', dtype: 'q8', timestamps: true };
    async function transcribe(i, t0, t1, opts = {}) {
      const o = { ...DEF, ...opts };
      st(`loading audio ${i}`);
      const pcm = await audio(i, t0, t1);
      const key = `${o.model}|${o.device}|${JSON.stringify(o.dtype)}`;
      if (!asr || asrKey !== key) { st('loading whisper'); asr = await pipeline('automatic-speech-recognition', o.model, { device: o.device, dtype: o.dtype }); asrKey = key; }
      st(`transcribing ${i}`);
      const r = await asr(pcm, { chunk_length_s: 30, stride_length_s: 5, return_timestamps: o.timestamps });
      st('done');
      return r;
    }
    let sv = null;
    async function embed(i, t0, t1) {
      const pcm = await audio(i, t0, t1);
      if (!sv) sv = { proc: await AutoProcessor.from_pretrained('Xenova/wavlm-base-plus-sv'), model: await AutoModel.from_pretrained('Xenova/wavlm-base-plus-sv') };
      const out = await sv.model(await sv.proc(pcm));
      const v = Array.from(out.embeddings.data);
      const n = Math.hypot(...v); return v.map((x) => x / n);
    }
    window.wcr = { list, audio, transcribe, embed, secs };
    st('ready');
  </script>
</Base>
