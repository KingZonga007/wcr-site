---
import { songUrl, songUrlBySlug, hasPage } from '../lib/songs.js';
import Base from '../layouts/Base.astro';
import EmailForm from '../components/EmailForm.astro';
import LiveStatus from '../components/LiveStatus.astro';
import { SITE, href, inSeason } from '../lib/site.js';
import featuredList from '../data/featured.json';
import songs from '../data/songs.json';
import episodes from '../data/episodes.json';
import { updates, fmtDate } from '../lib/updates.js';
import releases from '../data/releases.json';

// Most popular first (Ryan's order)
// Order set in src/data/featured.json (also the default view on /songs).
const featuredSlugs = featuredList.slice(0, 6);
const featured = featuredSlugs.map((s) => songs.find((x) => x.slug === s)).filter(Boolean);
// Latest release: kept current by scripts/update-content.mjs; falls back to the newest song.
const latestRel = releases.latest;
const episodeCount = Math.max(...episodes.map((e) => e.number));
const latestUpdates = updates(4);
const chartCount = songs.filter((s) => s.charts.recording || s.charts.congregational).length;
const released = songs.filter((s) => !s.unreleased);
const latest = latestRel ? (songs.find((s) => s.title.toLowerCase() === latestRel.title.toLowerCase()) || released[0]) : released[0];
const latestLinks = latestRel ? { spotify: latestRel.spotify || latest.listen.spotify, apple: latestRel.apple || latest.listen.apple, youtube: latestRel.youtube || latest.listen.youtube, amazon: latestRel.amazon || latest.listen.amazon } : latest.listen;
const latestYear = latestRel ? latestRel.date.slice(0, 4) : latest.year;
const ep = episodes[0];
const STORE_ON = false; // switched on in phase 3
---
<Base current="home">
  <!-- 1. Hero -->
  {inSeason('christmas') && (
    <section class="xmas-band" data-season-end={SITE.season.christmas.to} aria-label="Christmas">
      <div class="wrap">
        <div>
          <p class="eyebrow xmas-eyebrow" style="margin:0">Christmas with West Coast Revival</p>
          <h2>We Three Kings</h2>
          <p>Free chord chart for your church, plus a Christmas worship set.</p>
        </div>
        <div class="btn-row">
          <a class="btn xmas-btn" href={href('/christmas')}>Christmas charts</a>
          <a class="btn ghost" href={href('/songs/we-three-kings')}>Listen</a>
        </div>
      </div>
    </section>
  )}

  <section class="hero">
    <picture>
      <source media="(max-width: 700px)" srcset="/img/jon-best-800.webp" />
      <img width="1200" height="800" class="bg" src="/img/jon-best-1600.webp" alt="Jonathan Baird leading worship on guitar" fetchpriority="high" style="object-position:70% 15%" />
    </picture>
    <div class="wrap">
      <p class="eyebrow">West Coast Revival</p>
      <h1 class="hero-title"><span>Timeless truth.</span><span>Untamed affection.</span></h1>
      <p class="lead" style="color: var(--ink)">Songs that magnify Jesus Christ, from the writers of "Behold Our God."</p>
      <div class="btn-row" style="margin: 22px 0 28px">
        <a class="btn ghost" href="#listen">Listen</a>
        <a class="btn ghost" href={href('/songs')}>Free charts</a>
      </div>
      <p style="font-weight:600;margin-bottom:8px">Get new songs and free charts first</p>
      <EmailForm source="hero" cta="Sign up" musicianOption compact />
    </div>
  </section>

  <!-- 1b. Mission -->
  <section class="section mission-band" aria-label="Our mission">
    <div class="wrap grid two" style="align-items:center">
      <div>
        <p class="eyebrow">A 501(c)(3) nonprofit worship ministry</p>
        <h2>Our mission</h2>
        <p class="lead">{SITE.mission}</p>
        <p>Everything we make for the church is free: chord charts for worship teams, a twice-weekly live show of worship and Scripture, and our songs on every major streaming service.</p>
        <a class="btn ghost" href={href('/ministry')}>Our ministry and programs</a>
      </div>
      <ul class="programs">
        <li><a href={href('/songs')}><strong>Free chord charts</strong><span>{chartCount} songs in recording and congregational keys, free for any church</span></a></li>
        <li><a href={href('/worship-is-warfare')}><strong>Worship Is Warfare</strong><span>Live worship and Scripture every Tuesday and Thursday, {episodeCount} episodes and counting</span></a></li>
        <li><a href={href('/songs')}><strong>Songwriting and recording</strong><span>Congregational songs and hymn arrangements since 2003, including "Behold Our God"</span></a></li>
        <li><a href={href('/invite')}><strong>Serving local churches</strong><span>Worship nights, conferences and help for worship teams</span></a></li>
      </ul>
    </div>
  </section>

  <!-- 1c. Latest updates -->
  <section class="section" aria-label="Latest updates">
    <div class="wrap">
      <p class="eyebrow">What's new</p>
      <h2>Latest updates</h2>
      <ol class="updates">
        {latestUpdates.map((u) => (
          <li>
            <p class="eyebrow" style="margin:0">{u.kind} · <time datetime={u.date}>{fmtDate(u.date)}</time></p>
            <h3><a href={href(u.href)}>{u.title}</a></h3>
            {u.text && <p class="muted">{u.text}</p>}
          </li>
        ))}
      </ol>
      <a class="btn ghost" href={href('/updates')} style="margin-top:16px">All updates</a>
    </div>
  </section>

  <!-- 2. Proof strip -->
  <section class="proof" aria-label="About West Coast Revival at a glance">
    <ul class="wrap">
      <li>Behold Our God<span>Written by the Bairds, sung by churches worldwide</span></li>
      <li>Sovereign Grace Music<span>Contributing songwriters and artists since 2005</span></li>
      <li>Worship Is Warfare Livestream<span>100+ episodes available, live twice a week</span></li>
      <li>{chartCount} free chord charts<span>Recording and congregational keys, with more added regularly</span></li>
    </ul>
  </section>

  <!-- 3. Worship Is Warfare -->
  <section class="section" id="worship-is-warfare">
    <div class="wrap grid two">
      <div class="photo"><img width="1200" height="800" src="/img/img-8165-1600.webp" alt="Ryan Baird with hand raised in worship, Psalm 150 projected behind him" loading="lazy" /></div>
      <div>
        <p class="eyebrow">Live {SITE.wiw.label}</p>
        <h2>Worship Is Warfare</h2>
        <LiveStatus />
        <p class="lead" style="margin-top:16px">Every morning the war for allegiance begins. Who will you serve? Start your day lifting your eyes above earthly concerns, with worship and encouragement from the Word.</p>
        <p class="muted">Latest: <a href={`https://www.youtube.com/watch?v=${ep.youtubeId}`} data-out="youtube">#{ep.number} {ep.title}</a></p>
        <div class="btn-row" style="margin:18px 0 24px">
          <a class="btn primary" href={href('/worship-is-warfare')}>Watch and listen</a>
          <a class="btn ghost" href={SITE.social.youtubeSubscribe} data-out="youtube">Subscribe on YouTube</a>
        </div>
        <p style="font-weight:600;margin-bottom:8px">Get a reminder before each live stream</p>
        <EmailForm source="wiw-home" event="reminder_signup" cta="Remind me" compact thanks="Done. We'll email you before each live stream." />
      </div>
    </div>
  </section>

  <!-- 4. Latest release -->
  <section class="section alt" style="background: linear-gradient(rgba(10,12,22,.82), rgba(10,12,22,.92)), url('/img/f-img-8420-1600.webp') center/cover">
    <div class="wrap">
      <p class="eyebrow">Latest release · {latestYear}</p>
      <h2>{latest.title}</h2>
      <div class="listen-row" style="margin:18px 0">
        <a class="btn primary" href={latestLinks.spotify} data-out="spotify">Spotify</a>
        <a class="btn ghost" href={latestLinks.apple} data-out="apple_music">Apple Music</a>
        {!latestLinks.youtube.includes('/results?') && <a class="btn ghost" href={latestLinks.youtube} data-out="youtube">YouTube</a>}
        {!latestLinks.amazon.includes('/search/') && <a class="btn ghost" href={latestLinks.amazon} data-out="amazon">Amazon Music</a>}
      </div>
      <a href={href(songUrl(latest))}>{hasPage(latest) ? 'Get the free chord charts' : 'See all songs and charts'}</a>
    </div>
  </section>

  <!-- 5. Free charts -->
  <section class="section">
    <div class="wrap">
      <div class="grid two" style="align-items:end;margin-bottom:28px">
        <div>
          <p class="eyebrow">For worship leaders</p>
          <h2>Free chord charts for your church</h2>
          <p class="lead">Our charts come in two keys: the recording key, and a congregational key that's easier for most churches to sing. Free for your church, always, with new charts added regularly.</p>
        </div>
        <div class="photo" style="max-height:260px"><img width="800" height="533" src="/img/elec-close-up-800.webp" alt="Close-up of hands playing an electric guitar" loading="lazy" /></div>
      </div>
      <div class="grid three">
        {featured.map((s) => (
          <a class="card song-card" href={href(songUrl(s))}>
            {(s.charts.recording || s.charts.congregational) && <span class="badge">Free charts</span>}
            <h3>{s.title}</h3>
            {s.key && <span class="meta">Key of {s.key}</span>}
          </a>
        ))}
      </div>
      <p style="margin-top:24px"><a class="btn ghost" href={href('/songs')}>See all {songs.length} songs</a></p>
    </div>
  </section>

  <!-- 6. Listen and watch -->
  <section class="section alt" id="listen">
    <div class="wrap grid two">
      <div>
        <p class="eyebrow">Listen and watch</p>
        <h2>Hear the songs</h2>
        <p class="lead">Every West Coast Revival song is on all major streaming services.</p>
        <div class="listen-row" style="margin-top:18px">
          <a class="btn primary" href={SITE.social.spotify} data-out="spotify">Follow on Spotify</a>
          <a class="btn ghost" href={SITE.social.youtubeSubscribe} data-out="youtube">Subscribe on YouTube</a>
        </div>
      </div>
      <div class="card">
        <h3>Listen free</h3>
        <p class="muted">Start with "Behold Our God," then the newest singles.</p>
        <div class="btn-row" style="margin-top:12px">
          <a class="btn ghost" href={SITE.social.spotify} data-out="spotify">Spotify</a>
          <a class="btn ghost" href="https://music.apple.com/us/artist/west-coast-revival/189482804" data-out="apple_music">Apple Music</a>
          <a class="btn ghost" href={SITE.social.youtube} data-out="youtube">YouTube</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Who we are -->
  <section class="section">
    <div class="wrap grid two">
      <div class="photo"><img width="800" height="832" src="/img/brothers-portrait-800.webp" alt="Brothers Ryan and Jonathan Baird" loading="lazy" /></div>
      <div>
        <p class="eyebrow">Who we are</p>
        <h2>Two brothers, one aim</h2>
        <p class="lead">{SITE.mission}</p>
        <p>Our goal is to plug a cord into the Bible, put the other end in an amplifier and dial it up to 11. There are no songs creative or loud enough to be worthy of the greatness of God, but we're going to give it our best.</p>
        <a class="btn ghost" href={href('/about')}>Our story</a>
      </div>
    </div>
  </section>

  <!-- 8. Invite us -->
  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Invite us</p>
      <h2>Bring West Coast Revival to your church</h2>
      <div class="grid four" style="margin-top:24px">
        <a class="tile" href={href('/invite')}><img width="800" height="533" src="/img/band-best-800.webp" alt="" loading="lazy" /><div class="tile-body"><h3>Conference worship leading</h3></div></a>
        <a class="tile" href={href('/invite')}><img width="800" height="533" src="/img/img-8084-800.webp" alt="" loading="lazy" /><div class="tile-body"><h3>Concerts and worship nights</h3></div></a>
        <a class="tile" href={href('/invite')}><img width="800" height="533" src="/img/ryan-worship-800.webp" alt="" loading="lazy" /><div class="tile-body"><h3>Speaking and teaching</h3></div></a>
        <a class="tile" href={href('/invite')}><img width="800" height="533" src="/img/img-8324-800.webp" alt="" loading="lazy" /><div class="tile-body"><h3>Workshops and seminars</h3></div></a>
      </div>
      <p style="margin-top:24px"><a class="btn primary" href={href('/invite')}>Send an inquiry</a></p>
    </div>
  </section>

  <!-- 9. Store teaser (off until phase 3) -->
  {STORE_ON && <section class="section"><div class="wrap"><h2>Store</h2></div></section>}

  <!-- 10. Give -->
  <section class="section" style="background: linear-gradient(rgba(10,12,22,.78), rgba(10,12,22,.9)), url('/img/atmosphere-1600.webp') center/cover">
    <div class="wrap">
      <p class="eyebrow">Partner with us</p>
      <h2>Keep the songs free</h2>
      <p class="lead">Gifts fund new recordings, free charts for churches and Worship Is Warfare. West Coast Revival is a 501(c)(3) nonprofit.</p>
      <a class="btn primary" href={href('/give')}>Give</a>
    </div>
  </section>
</Base>
