---
import Base from '../layouts/Base.astro';
import { SITE, href } from '../lib/site.js';
const bios = {
  short: 'West Coast Revival is a 501(c)(3) nonprofit worship ministry led by brothers Jonathan and Ryan Baird, writers of "Behold Our God" and a widely sung adaptation of "All Creatures of Our God and King." The ministry gives churches free songs and chord charts, serves worship teams, and hosts Worship Is Warfare, a live broadcast and podcast of worship and Scripture.',
  medium: 'West Coast Revival is a 501(c)(3) nonprofit worship ministry led by brothers Jonathan and Ryan Baird. Since founding the ministry in 2003, they have written congregational songs with and alongside Sovereign Grace Music, and co-wrote "Behold Our God" (2011), now sung in churches around the world. Since 2019 they have shared a steady stream of new songs with churches, including "Solid Rock," "In You Is Mercy" and "Have You Been to Jesus." Every song comes with free chord charts for churches. They host Worship Is Warfare, a live broadcast and podcast that pairs worship with an exhortation from Scripture. Their aim: to magnify Jesus Christ through songs that marry timeless truth with untamed affection.',
};
const photos = [
  { f: 'brothers-portrait', alt: 'Jonathan and Ryan Baird, portrait' },
  { f: 'cover-1', alt: 'Live, full stage' },
  { f: 'band-best', alt: 'Leading worship live' },
  { f: 'jon-best', alt: 'Jonathan Baird live' },
  { f: 'ryan-3', alt: 'Ryan Baird live' },
  { f: 'img-8305', alt: 'Jonathan Baird, portrait orientation' },
];
---
<Base title="Media Kit" description="West Coast Revival media kit: ministry overview, bios, photos and contact for churches, event hosts and media." image="/img/brothers-portrait-800.webp">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Media kit</p>
      <h1>West Coast Revival</h1>
      <p class="lead">{SITE.credential}</p>
      <div class="btn-row"><a class="btn primary" href={href('/invite')}>Invite us to your church</a></div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap grid two" style="align-items:start">
      <div class="prose">
        <h2>Bios</h2>
        <h3>Short</h3><p>{bios.short}</p>
        <h3>Medium</h3><p>{bios.medium}</p>
        <h3>Long</h3><p>See <a href={href('/about')}>About</a>.</p>
      </div>
      <div class="card">
        <h2>Highlights</h2>
        <ul>
          <li>Co-writers of "Behold Our God" (Sovereign Grace Music, 2011)</li>
          <li>Arrangement of "All Creatures of Our God and King" sung in churches</li>
          <li>Free chord charts for churches in recording and congregational keys</li>
          <li>Worship Is Warfare, 100+ episodes of worship and Scripture</li>
          <li>501(c)(3) nonprofit ministry, EIN {SITE.ein}</li>
        </ul>
        <h3 style="margin-top:20px">Contact</h3>
        <p class="muted">Church invitations and media: <a href={href('/invite')}>inquiry form</a></p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2>Photos</h2>
      <p class="muted">Free to use when announcing a West Coast Revival event or writing about the ministry. For high-resolution files, email {SITE.email}.</p>
      <div class="grid three">
        {photos.map((p) => (
          <a class="photo" href={`/img/${p.f}-1600.webp`} download><img width="800" height="600" src={`/img/${p.f}-800.webp`} alt={p.alt} loading="lazy" style="aspect-ratio:4/3" /></a>
        ))}
      </div>
    </div>
  </section>
</Base>
