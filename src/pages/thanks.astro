---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site.js';
const confirmed = Astro.url.searchParams.get('confirmed');
---
<Base title="Thank you" current="invite">
  <section class="section">
    <div class="wrap">
      {confirmed === '1' ? (
        <>
          <p class="eyebrow">Confirmed</p>
          <h1>You're in</h1>
          <p class="lead">Your email is confirmed. Check your inbox: a welcome email just went out.</p>
        </>
      ) : confirmed === '0' ? (
        <>
          <p class="eyebrow">Link expired</p>
          <h1>That link didn't work</h1>
          <p class="lead">It may have expired. Sign up again from the form and we'll send a fresh confirmation link.</p>
        </>
      ) : (
        <>
          <p class="eyebrow">Inquiry sent</p>
          <h1>Thank you</h1>
          <p class="lead">We've got your request and will reply within a few days. While you wait, catch the next Worship Is Warfare live stream.</p>
        </>
      )}
      <div class="btn-row"><a class="btn primary" href={href('/worship-is-warfare')}>Worship Is Warfare</a><a class="btn ghost" href={href('/songs')}>Songs and charts</a></div>
    </div>
  </section>
</Base>
