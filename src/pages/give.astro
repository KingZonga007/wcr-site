---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site.js';
---
<Base title="Give" description="Support West Coast Revival, a 501(c)(3) nonprofit ministry. Gifts fund new songs for congregations, free chord charts for churches and Worship Is Warfare." image="/img/atmosphere-1600.webp">
  <section class="hero" style="min-height:60vh">
    <img width="1200" height="800" class="bg" src="/img/atmosphere-1600.webp" alt="" />
    <div class="wrap">
      <p class="eyebrow">Partner with us</p>
      <h1>Keep the songs free</h1>
      <p class="lead" style="color:var(--ink)">West Coast Revival is a 501(c)(3) nonprofit ministry (EIN {SITE.ein}). Every gift is tax-deductible as allowed by law.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap"><h2 class="sr-only">What your gift supports</h2></div>
    <div class="wrap grid three">
      <div class="card"><h3>New songs</h3><p class="muted">Writing and recording congregational songs that magnify Christ, free for churches to sing.</p></div>
      <div class="card"><h3>Free charts</h3><p class="muted">A growing library of chord charts in recording and congregational keys, free for any church.</p></div>
      <div class="card"><h3>Worship Is Warfare</h3><p class="muted">The live broadcast and podcast of worship and Scripture, every Tuesday and Thursday morning.</p></div>
    </div>
    <div class="wrap" style="margin-top:40px">
      <div class="card" style="max-width:640px">
        <h2>Give online</h2>
        <p class="muted">Giving is handled securely through the National Christian Foundation (NCF).</p>
        <a class="btn primary" href={SITE.give} data-out="give_ncf" id="give-btn">Give securely through NCF</a>
      </div>
    </div>
    <div class="wrap prose" style="margin-top:48px;max-width:760px">
      <h2>How your gift is used</h2>
      <p>West Coast Revival is supported by charitable gifts. We do not sell products on this website, and everything we make for churches is free: chord charts, Worship Is Warfare and our recorded songs on streaming services. Gifts pay for writing, recording and releasing new songs, preparing free charts in two keys, and producing Worship Is Warfare twice a week.</p>
      <h2>Financial transparency</h2>
      <p>{SITE.legalName} is an Arizona nonprofit corporation and a 501(c)(3) tax-exempt organization, EIN {SITE.ein}. You can confirm our status in the <a href="https://apps.irs.gov/app/eos/" rel="noopener">IRS Tax Exempt Organization Search</a>. Online gifts are processed by the National Christian Foundation, a trusted Christian giving platform. Financial information is available on request at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>. Learn more about <a href="/ministry">our ministry and programs</a>.</p>
      <h2>Other ways to help</h2>
      <ul>
        <li><strong>Pray for us.</strong> Pray that the songs would be true to Scripture and useful to local churches.</li>
        <li><strong>Use the charts.</strong> Lead the songs at your church and pass the <a href="/songs">free chord charts</a> to other worship leaders.</li>
        <li><strong>Share Worship Is Warfare.</strong> Send an <a href="/worship-is-warfare">episode</a> to someone who needs encouragement from the Word.</li>
        <li><strong>Invite us.</strong> Ask your church or conference to <a href="/invite">bring us in</a> to lead worship or teach.</li>
      </ul>
    </div>
  </section>
  <script is:inline>
    document.getElementById('give-btn').addEventListener('click', function () { window.wcrTrack('donation_click', { provider: 'ncf' }); });
  </script>
</Base>
